{
  "name": "pet-claude-spa",
  "version": "1.0.0",
  "description": "Pet Claude della spa: a pixel-art desktop pet that follows Claude Code activity",
  "type": "commonjs",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test tests/",
    "install-hooks": "node src/hooks/install.js",
    "uninstall-hooks": "node src/hooks/install.js --uninstall",
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.petclaudespa",
    "productName": "PetClaudeSpa",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "PetClaudeSpa.exe"
    }
  }
}
